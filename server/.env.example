# Environment
NODE_ENV=development
PORT=4000

# Database URLs (PostgreSQL)
# Locally, DATABASE_URL and DIRECT_URL are the same.
# On Neon, DATABASE_URL is pooled and DIRECT_URL is direct.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quizarena?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/quizarena?schema=public"

# Authentication
# Must be at least 32 characters
JWT_SECRET="quizarena-development-secret-jwt-token-key-must-be-very-long"
JWT_EXPIRES_IN="24h"

# Client Application URL (for CORS allow-list, no trailing slash)
CLIENT_URL="http://localhost:5173"

# Automatic demo seeding on start if users table is empty
SEED_DEMO="true"
